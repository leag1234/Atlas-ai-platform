# Public Open WebUI settings; provider credentials are never passed here.
HOST=127.0.0.1
PORT=3000
WEBUI_AUTH=False
WEBUI_NAME=Atlas
ENABLE_VERSION_UPDATE_CHECK=False
ENABLE_EVALUATION_ARENA_MODELS=False
ATLAS_REMOVE_OPEN_WEBUI_SUFFIX=0
ENABLE_FORWARD_USER_INFO_HEADERS=True
ENABLE_OLLAMA_API=False
ENABLE_AUTOCOMPLETE_GENERATION=False
ENABLE_DIRECT_CONNECTIONS=False
ENABLE_COMMUNITY_SHARING=False
ENABLE_CODE_EXECUTION=True
ENABLE_CODE_INTERPRETER=True
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_PERSISTENT_CONFIG=False
OPENAI_API_BASE_URL=http://127.0.0.1:8020/v1
OPENAI_API_KEY=atlas-local
HF_HUB_OFFLINE=1
RAG_EMBEDDING_MODEL_AUTO_UPDATE=False
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
# NOTE: code execution/interpreter enabled — UI access is LOCAL only
# (SSH tunnel, single user). Review required before any exposure.
# DIRECT_CONNECTIONS and COMMUNITY_SHARING remain disabled (gateway bypass and
# external prompt sharing).
# NOTE: code execution/interpreter enabled — UI access is LOCAL only
# (SSH tunnel, single user). Review required before any exposure.
# DIRECT_CONNECTIONS and COMMUNITY_SHARING remain disabled (gateway bypass and
# external prompt sharing).

# Auxiliary generation is disabled: it has no separate budget in this PoC.
# Environment settings override historical settings in the persistent UI volume.

# M23: originals are forwarded by the owned inlet; no embedding/retrieval for attachments.
BYPASS_EMBEDDING_AND_RETRIEVAL=True

# M24 runtime replaces the key through docker -e, never stores it here.
TERMINAL_SERVER_CONNECTIONS=[{"id":"atlas-files","url":"http://open-terminal:8000","auth_type":"bearer","config":{"chat_uploads":"filesystem"}}]
