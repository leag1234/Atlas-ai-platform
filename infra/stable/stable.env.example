# Fill every value in /opt/atlas-src/stable.env (mode 600). Do not copy values here.
ESCALATION_MODEL=
SCW_GENERATIVE_BASE_URL=
SCW_GENERATIVE_API_KEY=
TAVILY_API_KEY=
OPEN_TERMINAL_API_KEY=
WEBUI_SECRET_KEY=
ATLAS_TRUSTED_EMAIL_HEADER=
ATLAS_PROXY_SECRET=
ATLAS_SECRETS_FILE=
ATLAS_INTERACTION_DIR=
ATLAS_WEB_CACHE=
ATLAS_HEALTHCHECK_USER=
ATLAS_STABLE=
# Set to 1 only for deployments with at most 50 users in any rolling 30-day
# period, written permission from Open WebUI, or an enterprise license.
ATLAS_REMOVE_OPEN_WEBUI_SUFFIX=0
# Optional guest-instance banner. Plain text only; maximum 200 characters.
ATLAS_INSTANCE_NOTICE=
ATLAS_PORT_BASE=
GPU_LOCAL=
# Default trial provider; append an API-key provider for fallback, for example
# searxng,tavily or searxng,serpapi.
ATLAS_SEARCH_PROVIDER=searxng
ATLAS_PUBLIC_URL=
ATLAS_IMAGE_DIR=
ATLAS_PROJECT_DB=
# Project mode is off unless explicitly enabled. ATLAS_PROJECT_DSN must use
# the non-owner atlas_project_app role after the explicit schema installation.
# Build once: docker build -f infra/docker/Dockerfile --target runner -t atlas-project-runner:local .
ATLAS_PROJECT_MODE=0
ATLAS_PROJECT_DSN=
# Or, instead of ATLAS_PROJECT_DSN: the atlas_project_app password (at least 32 bytes);
# the launcher then builds the DSN with the runtime Postgres port, which changes at each start.
ATLAS_PROJECT_DB_PASSWORD=
ATLAS_PROJECT_IDENTITY_SECRET=
ATLAS_PROJECT_EXECUTION_SECRET=
ATLAS_PROJECT_SIGNING_KEY=
ATLAS_PROJECT_ORIGIN=
ATLAS_DATA_ROOT=/var/lib/atlas-stable/project-data
ATLAS_SCHEDULED_TASKS=0
ATLAS_REMOTE_RUNNERS=0
# Guest organization API-key bootstrap; persisted administrator policy wins.
ATLAS_API_KEY_ORG_ID=stable
ATLAS_API_KEY_POLICY=self_service
# Inject privately, at least 32 bytes; share with the public key edge/admin service.
ATLAS_API_KEY_PEPPER=
ATLAS_API_KEYS_DB=
