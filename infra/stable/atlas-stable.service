[Unit]
Description=ATLAS stable instance
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/atlas-src/stable
EnvironmentFile=/opt/atlas-src/stable.env
Environment=ATLAS_STABLE=1
Environment=ATLAS_PORT_BASE=100
ExecStart=/opt/atlas-src/stable/scripts/serve.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/opt/atlas-src/stable /var/lib/atlas-stable /var/lib/docker

[Install]
WantedBy=multi-user.target
