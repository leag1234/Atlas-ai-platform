# Dictation settings for staging (prepared, not applied): appended to the instance env file by the operator.
ATLAS_REALTIME_DICTATION=1
ATLAS_DICTATION_ENGINES=local,cloud
ATLAS_DICTATION_LOCAL_MAX_SESSIONS=2
ATLAS_DICTATION_LOCAL_THREADS=2
ATLAS_DICTATION_LOCAL_MODEL_DIR=/opt/atlas-src/models/stt-stream/parakeet-tdt-0.6b-v3-int8
ATLAS_DICTATION_LOCAL_VAD=/opt/atlas-src/models/stt-stream/silero-vad/silero_vad.onnx
ATLAS_DICTATION_CLEANUP=1
# Already present in staging.env and used as is: MISTRAL_API_KEY (cloud engine),
# ATLAS_PROJECT_ORIGIN (WebSocket Origin check), the fast profile settings (clean-up).
# Defaults kept: ATLAS_DICTATION_MAX_SECONDS=300, ATLAS_DICTATION_IDLE_SECONDS=20,
# ATLAS_DICTATION_MAX_SESSIONS=4, ATLAS_DICTATION_DELAY_MS=480, ATLAS_DICTATION_CLEANUP_INTERVAL_S=2.5,
# ATLAS_DICTATION_CLOUD_LANGUAGES=fr,en,de,es,it,nl (languages pinned on the cloud engine).
