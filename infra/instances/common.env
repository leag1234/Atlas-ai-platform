# Non-secret settings shared by every hosted instance (staging and production).
# Rendered with the instance overlay and the host's private file by tools/instance_env.py.
# A line here reaches production at the next promotion: put a setting meant for staging
# only in staging.env. Secrets, personal data and IP addresses never go here
# (tools/instance_env.py check refuses them).

# Models (Scaleway serverless generative APIs).
ESCALATION_MODEL=qwen3.5-397b-a17b
CODE_MODEL=glm-5.2
VISION_MODEL=gemma-4-26b-a4b-it
VISION_PREVIOUS_MODEL=pixtral-12b-2409
FAST_MODEL=deepseek-v4-flash-0731
EMBEDDING_SERVERLESS_MODEL=qwen3-embedding-8b
SCW_GENERATIVE_BASE_URL=https://api.scaleway.ai/v1

# Hosted instance mode.
ATLAS_STABLE=1
GPU_LOCAL=0
ATLAS_TRUSTED_EMAIL_HEADER=X-Atlas-User
ATLAS_SEARCH_PROVIDER=searxng,tavily,serpapi

# Public API.
ATLAS_OPENWEBUI_API_KEYS=1
ATLAS_API_KEY_ADMIN_SUBJECT=supervisor
ATLAS_RAW_CALL_MAX_MICRO_EUR=5000000
ATLAS_API_DEFAULT_RAW_MODEL=raw/deepseek-v4-flash-0731

# Features enabled on both instances.
ATLAS_PROJECT_MODE=1
ATLAS_SCHEDULED_TASKS=1
ATLAS_REMOTE_RUNNERS=1
ATLAS_GROUNDING=on
ATLAS_STABLE_PROJECT_WORK=1
ATLAS_CODE_COST_EUR=1
