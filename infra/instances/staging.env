# Staging overlay (staging.atlas.eu.com, unit atlas-staging, port base 200). Overrides
# common.env. Every line that production does not have carries a comment saying what it
# enables; it reaches production only when copied to production.env or common.env.

# Instance identity, paths and public addresses.
ATLAS_PORT_BASE=200
ATLAS_SECRETS_FILE=/opt/atlas-src/staging.env
ATLAS_PUBLIC_URL=https://staging.atlas.eu.com
ATLAS_PROJECT_ORIGIN=https://staging.atlas.eu.com
ATLAS_DATA_DIR=/var/lib/atlas-staging
ATLAS_DATA_ROOT=/var/lib/atlas-staging/project-data
ATLAS_INTERACTION_DIR=/var/lib/atlas-staging/logs
ATLAS_WEB_CACHE=/var/lib/atlas-staging/web.sqlite
ATLAS_IMAGE_DIR=/var/lib/atlas-staging/images
ATLAS_PROJECT_DB=/var/lib/atlas-staging/projects.sqlite
ATLAS_API_KEYS_DB=/var/lib/atlas-staging/api-keys.sqlite
ATLAS_KILL_SWITCH_FILE=/var/lib/atlas-staging/KILL
ATLAS_POLICY_FILE=/opt/atlas-src/staging-policy.json
ATLAS_TTS_URL=http://127.0.0.1:8231

# Budgets and search quotas (smaller than production).
ATLAS_GLOBAL_MONTHLY_EUR=100
ATLAS_USER_MONTHLY_EUR=40
ATLAS_TAVILY_USER_DAILY_SEARCHES=60
ATLAS_TAVILY_GLOBAL_DAILY_SEARCHES=120
ATLAS_TAVILY_GLOBAL_MONTHLY_SEARCHES=400
ATLAS_SERPAPI_USER_DAILY_SEARCHES=20
ATLAS_SERPAPI_GLOBAL_DAILY_SEARCHES=30
ATLAS_SERPAPI_GLOBAL_MONTHLY_SEARCHES=30
ATLAS_SEARXNG_ENGINES=startpage,duckduckgo,mojeek,seznam,qwant,brave,google

# --- Staging-only lines (not on production) ---

# Guest web UI image: Open WebUI v0.13.3 pinned by digest (production runs the code default).
ATLAS_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.3@sha256:46b59158e6558eeb980bc828e0f1b30238ad24d82ed84d5e5eda1dab2a082f14
# Default chat profile atlas-mistral instead of the code default.
ATLAS_DEFAULT_PROFILE=atlas-mistral
# Enables the hidden atlas-mistral profile (default profile and picture painter).
ATLAS_HIDDEN_PROFILES=atlas-mistral
# The model routes plain chat turns; the lexical patterns become the fallback.
ATLAS_MODEL_ROUTER=1
# Routing decision timeout in seconds (code default 4).
ATLAS_MODEL_ROUTER_TIMEOUT=8
# Chat titles written by the fast profile in one short call.
ATLAS_MODEL_TITLES=1
# Logs the provenance of numbers in answers (never changes the answer).
ATLAS_NUMBER_PROVENANCE=log

# Artifacts (published pages with versions and preview links).
ATLAS_ARTIFACTS=1
# Artifact versions accepted per hour (code default 30).
ATLAS_ARTIFACT_VERSIONS_PER_HOUR=300
# Artifact versions kept (code default 300).
ATLAS_ARTIFACT_MAX_VERSIONS=3000

# Work engine: project Work turns on code requests run in the OpenCode container.
ATLAS_WORK_ENGINE=opencode
# OpenCode calls the models through this instance's public API.
ATLAS_WORK_ENGINE_API_BASE=https://staging.atlas.eu.com/api/atlas/v1
# Work containers may reach package registries through the filtered egress.
ATLAS_WORK_EGRESS=registries
# Work container image (local image id built from infra/docker/Dockerfile.work).
ATLAS_WORK_IMAGE=sha256:243da7f520d2bb0ec9fbc1585d8357ce4e905e57ce76a2131e7c8720012a83d8
# A Work session keeps its workspace from one turn to the next.
ATLAS_WORK_CARRY=1
# Saving Work outputs back to the project (overwrites need the owner's approval).
ATLAS_WORK_SAVE=1
# Documents written by Work are streamed into the chat while they are produced.
ATLAS_WORK_STREAMED_DOCUMENTS=1
# Remote runner image built by deploy_staging.sh (promote.sh retags it for production).
ATLAS_RUNNER_IMAGE=atlas-project-runner:staging
# Relay for the users' own computers (WebSocket location of the front door).
ATLAS_RELAY_PUBLIC_URL=wss://staging.atlas.eu.com/relay/

# Voice: speech-to-text in the chat.
ATLAS_STT=1
# Allows speech-to-text on a hosted instance (guest audio is personal data: opt-in).
ATLAS_STABLE_STT=1
# Read-aloud button (local Piper service at ATLAS_TTS_URL).
ATLAS_TTS=1
# Real-time dictation: the Atlas voice button streams audio and writes the text once.
ATLAS_REALTIME_DICTATION=1
# Dictation engines, local first then the cloud engine.
ATLAS_DICTATION_ENGINES=local,cloud
# At most this many local dictation streams at once.
ATLAS_DICTATION_LOCAL_MAX_SESSIONS=2
# CPU threads per local dictation stream.
ATLAS_DICTATION_LOCAL_THREADS=2
# Local streaming speech model (Parakeet TDT 0.6B v3, int8).
ATLAS_DICTATION_LOCAL_MODEL_DIR=/opt/atlas-src/models/stt-stream/parakeet-tdt-0.6b-v3-int8
# Voice activity detection model for local dictation (Silero VAD).
ATLAS_DICTATION_LOCAL_VAD=/opt/atlas-src/models/stt-stream/silero-vad/silero_vad.onnx
# Live dictation text cleaned by the fast profile (guarded against invention).
ATLAS_DICTATION_CLEANUP=1

# Pictures by code (SVG painter; docs/21-pictures-by-code.md).
ATLAS_PICTURES_BY_CODE=1
# Provisional animal kit for the painter.
ATLAS_PICTURE_ANIMAL_KIT=1
# The painter writes a short plan before its SVG.
ATLAS_PICTURE_BRIEF_PLAN=1
# Drafts started beyond the four shown (0 to 2).
ATLAS_PICTURE_SPARE_DRAFTS=1
# Painting time after which the drafts already painted are kept (code default 120).
ATLAS_PICTURE_SOFT_SECONDS=125
# Cost ceiling of one picture turn in EUR.
ATLAS_PICTURE_TURN_EUR=0.15
# Pictures on the CPU image server (its URL is in the private file: it is an IP address).
ATLAS_PICTURES_CPU=1
# File holding the CPU image server's shared token (the token itself is not here).
ATLAS_PICTURE_CPU_TOKEN_FILE=/opt/atlas-src/pictures-cpu/token
# Self-signed certificate of the CPU image server.
ATLAS_PICTURE_CPU_CA=/opt/atlas-src/pictures-cpu/cert.pem
