# Production overlay (atlas.eu.com, unit atlas-stable, port base 100). Overrides common.env.
# A staging feature reaches production only when its line is added here (or to common.env)
# in a reviewed pull request; promote.sh never copies staging lines.

# Instance identity, paths and public addresses.
ATLAS_PORT_BASE=100
ATLAS_SECRETS_FILE=/opt/atlas-src/stable.env
ATLAS_PUBLIC_URL=https://atlas.eu.com
ATLAS_PROJECT_ORIGIN=https://atlas.eu.com
ATLAS_DATA_DIR=/var/lib/atlas-stable
ATLAS_DATA_ROOT=/var/lib/atlas-stable/project-data
ATLAS_INTERACTION_DIR=/var/lib/atlas-stable/logs
ATLAS_WEB_CACHE=/var/lib/atlas-stable/web.sqlite
ATLAS_IMAGE_DIR=/var/lib/atlas-stable/images
ATLAS_PROJECT_DB=/var/lib/atlas-stable/projects.sqlite
ATLAS_API_KEYS_DB=/var/lib/atlas-stable/api-keys.sqlite
ATLAS_KILL_SWITCH_FILE=/var/lib/atlas-stable/KILL
ATLAS_POLICY_FILE=/opt/atlas-src/stable-policy.json
ATLAS_TTS_URL=http://127.0.0.1:8131

# Budgets and search quotas.
ATLAS_GLOBAL_MONTHLY_EUR=1200
ATLAS_USER_MONTHLY_EUR=30
ATLAS_TAVILY_USER_DAILY_SEARCHES=50
ATLAS_TAVILY_GLOBAL_DAILY_SEARCHES=150
ATLAS_TAVILY_GLOBAL_MONTHLY_SEARCHES=300
ATLAS_SERPAPI_USER_DAILY_SEARCHES=50
ATLAS_SERPAPI_GLOBAL_DAILY_SEARCHES=150
ATLAS_SERPAPI_GLOBAL_MONTHLY_SEARCHES=150
ATLAS_SEARXNG_ENGINES=duckduckgo,bing,brave,qwant,google,startpage
